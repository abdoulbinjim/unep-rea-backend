{
  "kind": "collectionType",
  "collectionName": "news_items",
  "info": {
    "singularName": "news",
    "pluralName": "news-items",
    "displayName": "News"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "blocks"
    },
    "date": {
      "type": "datetime"
    },
    "category": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "news",
        "press",
        "video"
      ]
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "url": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "youtube_link": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "category"
            },
            "video"
          ]
        }
      }
    }
  }
}
