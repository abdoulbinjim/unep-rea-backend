{
  "kind": "collectionType",
  "collectionName": "contact_messages",
  "info": {
    "singularName": "contact-message",
    "pluralName": "contact-messages",
    "displayName": "Contact Message"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "message_status": {
      "type": "enumeration",
      "default": "new",
      "enum": [
        "new",
        "in_progress",
        "resolved"
      ]
    },
    "received_at": {
      "type": "datetime",
      "unique": false
    }
  }
}
